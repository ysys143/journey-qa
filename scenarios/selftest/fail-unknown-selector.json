{
  "schema_version": 1,
  "id": "selectors",
  "title": "locators through a selector map",
  "roster": "../../fixtures/roster.example.json",
  "determinism": {
    "seed": 42,
    "time_anchor": "2030-01-15T14:00:00+00:00",
    "viewport": {
      "width": 1440,
      "height": 900,
      "device_scale_factor": 2
    },
    "locale": "en-US",
    "timezone": "UTC"
  },
  "personas": [
    {
      "ref": "ivy",
      "as": "admin"
    }
  ],
  "steps": [
    {
      "id": "open-login",
      "persona": "ivy",
      "surface": "browser",
      "action": "goto",
      "target": "/login",
      "expect": {
        "visible": [
          "@login.email"
        ]
      }
    },
    {
      "id": "type-email",
      "persona": "ivy",
      "surface": "browser",
      "action": "fill",
      "target": "@login.mail",
      "value": "{{persona.ivy.email}}"
    },
    {
      "id": "submit",
      "persona": "ivy",
      "surface": "browser",
      "action": "click",
      "target": "@login.submit",
      "expect": {
        "visible": [
          "@user-menu({{persona.ivy.name}})"
        ]
      },
      "shot": "home"
    }
  ],
  "shots": [
    {
      "id": "home",
      "file": "01-home.png",
      "wait_for": [
        "@user-menu({{persona.ivy.name}})"
      ]
    }
  ],
  "selectors": "selectors.test.json"
}
