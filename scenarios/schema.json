{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "journey-qa/scenario.schema.json",
  "title": "journey-qa scenario",
  "description": "A journey written declaratively: personas, steps with expected state, shot list with view state, assertions, human gates. Produced by codify, executed by run. validate.py enforces this schema plus cross-references (roster ids, step ids, shot ids).",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "roster",
    "determinism",
    "personas",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "adapter": {
      "type": [
        "string",
        "null"
      ],
      "description": "adapters/<name>, or null for a product-agnostic example."
    },
    "roster": {
      "type": "string",
      "description": "Path to roster.json, relative to this scenario file."
    },
    "selectors": {
      "type": "string",
      "description": "Path to the adapter selector map (JSON), relative to this file. A locator written as @<name> or @<name>(<arg>) resolves through the map's 'selectors' object; {arg} in the mapped value is replaced by <arg>. Keeps product selectors out of the runner."
    },
    "determinism": {
      "type": "object",
      "required": [
        "seed",
        "time_anchor",
        "viewport",
        "locale",
        "timezone"
      ],
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "integer"
        },
        "time_anchor": {
          "type": "string",
          "description": "ISO 8601 with offset. 'now' for generated data and the browser clock."
        },
        "viewport": {
          "type": "object",
          "required": [
            "width",
            "height",
            "device_scale_factor"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 320
            },
            "height": {
              "type": "integer",
              "minimum": 320
            },
            "device_scale_factor": {
              "type": "number",
              "minimum": 1
            }
          }
        },
        "locale": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "color_scheme": {
          "enum": [
            "light",
            "dark"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "purpose",
              "base_url"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "base_url": {
                "type": "string"
              }
            }
          }
        },
        "clean_room_checks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Commands whose empty output proves no product traces exist before install."
        }
      }
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "as"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "description": "roster people[].id"
          },
          "as": {
            "type": "string",
            "description": "Role in this journey (admin, invitee, viewer...)."
          }
        }
      }
    },
    "setup": {
      "type": "array",
      "description": "Preparation that is NOT under test. Done via API or CLI, never by driving the UI.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "via",
          "run"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "via": {
            "enum": [
              "api",
              "cli",
              "sql"
            ]
          },
          "run": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "before_step",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "before_step": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "real-login",
              "waiver",
              "image-approval",
              "publish",
              "prod-access",
              "other"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "persona",
          "surface",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "persona": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "surface": {
            "enum": [
              "browser",
              "terminal",
              "api"
            ]
          },
          "action": {
            "enum": [
              "goto",
              "click",
              "fill",
              "select",
              "press",
              "wait",
              "run",
              "request"
            ]
          },
          "target": {
            "type": "string",
            "description": "URL path (goto), locator (click/fill/select/press/wait)."
          },
          "value": {
            "type": "string",
            "description": "Fill/select value or key. May use {{persona.<id>.<field>}} or {{secret.<name>}}."
          },
          "command": {
            "type": "string",
            "description": "terminal run: the exact command from the public docs."
          },
          "interactive": {
            "type": "array",
            "description": "terminal run under a pty: prompt -> answer pairs. Secret answers come from {{secret.<name>}} files, never literals.",
            "items": {
              "type": "object",
              "required": [
                "expect",
                "send"
              ],
              "additionalProperties": false,
              "properties": {
                "expect": {
                  "type": "string"
                },
                "send": {
                  "type": "string"
                }
              }
            }
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "body": {}
            }
          },
          "docs_ref": {
            "type": "string",
            "description": "Where the public docs tell the user to do this (file#anchor). Missing = docs defect candidate."
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "url_pattern": {
                "type": "string"
              },
              "visible": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "hidden": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "text": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exit_code": {
                "type": "integer"
              },
              "stdout_contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "integer"
              }
            }
          },
          "secrets": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "to_run_denylist": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Locators whose text is a one-off secret. Appended to the run denylist BEFORE any capture of this screen."
              },
              "invalidate_after": {
                "type": "string",
                "description": "Step id after which the secret must be proven dead."
              },
              "capture_as": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "description": "Name under which the text of the first to_run_denylist locator is kept, in memory only, for later {{secret.<name>}} use."
              }
            }
          },
          "shot": {
            "type": "string",
            "description": "shots[].id captured after this step's expectations hold."
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "wait_for"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "pattern": "^[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*(\\.light|\\.dark)?\\.png$"
          },
          "instance": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "view_state": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "filters": {
                "type": "object"
              },
              "scroll": {
                "description": "'top', or {selector}, or {y}."
              },
              "expand": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "theme": {
                "enum": [
                  "light",
                  "dark"
                ]
              }
            }
          },
          "wait_for": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "no_truncate": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Locators that must satisfy scrollWidth <= clientWidth."
          },
          "variants": {
            "type": "array",
            "items": {
              "enum": [
                "light",
                "dark"
              ]
            }
          },
          "docs_target": {
            "type": "string"
          },
          "terminal_from": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Step id, or step ids in order, whose redacted transcripts are concatenated and rendered instead of a browser capture."
          }
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "check"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "ui",
              "api",
              "sql",
              "file"
            ]
          },
          "check": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string"
        },
        "max_diff_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string"
        }
      }
    }
  }
}
